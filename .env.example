# Copy to `.env` at repo root for docker compose and local backend.

# ---- Backend (never expose service role key to the browser) ----
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional backend
# PORT=4000
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend.example.com

# ---- Frontend (optional; defaults use same-origin /api proxy) ----
VITE_API_BASE_URL=""
VITE_API_PROXY_TARGET="http://localhost:4000"
