# Copy to `.env` at the repo root for `docker compose` (SUPABASE_*).
# For local Vite dev, optional overrides in `src/frontend/.env.local`.

# ---- Backend (never expose service role key to the browser) ----
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional backend
# PORT=4000
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend.example.com

# ---- Frontend ----
# Default "" uses same-origin /api (Mode A proxy)
VITE_API_BASE_URL=""

# Vite dev proxy target when running `npm run dev` in src/frontend
VITE_API_PROXY_TARGET="http://localhost:4000"
